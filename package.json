{
  "name": "secrets-env-scanner",
  "displayName": "Secret & Env Sentinel",
  "description": "Scan your codebase for secrets, API keys, and exposed environment variables",
  "version": "0.0.2",
  "publisher": "sairapaka",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sairapaka09/Secrets-Env-Vars-Sentinel"
  },
  "bugs": {
    "url": "https://github.com/sairapaka09/Secrets-Env-Vars-Sentinel/issues"
  },
  "keywords": [
    "secrets",
    "security",
    "env",
    "environment variables",
    "api key",
    "credentials",
    "scanner"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "secrets-env-scanner.scanWorkspace",
        "title": "Secrets Scanner: Scan Workspace for Secrets"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "secretsEnvScannerView",
          "name": "Secrets Scanner Findings"
        }
      ]
    },
    "configuration": {
      "title": "Secrets & Env Vars Scanner",
      "properties": {
        "secretsEnvScanner.disabledPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Pattern IDs to disable (e.g. \"aws-access-key\", \"generic-api-key\")."
        },
        "secretsEnvScanner.excludeGlob": {
          "type": "string",
          "default": "{**/{node_modules,.git,.svn,.hg,out,dist,build,.next,.nuxt,.turbo,coverage,.vscode,.vscode-test,.idea,.vs,vendor,.venv,venv,__pycache__,.pytest_cache,.mypy_cache,.cache,.parcel-cache,.yarn,.pnpm-store,target,bin,obj,.terraform,.serverless,tmp}/**,**/*.{lock,min.js,map,pyc,pyo,so,dll,dylib,exe,woff,woff2,ttf,eot,png,jpg,jpeg,gif,ico,svg,pdf,zip,tar,gz,jar,class},**/{package-lock.json,yarn.lock,pnpm-lock.yaml,npm-shrinkwrap.json,composer.lock,Gemfile.lock,Cargo.lock,poetry.lock,Pipfile.lock}}",
          "description": "Glob pattern of files/folders to exclude from workspace scans (editor/IDE config, build output, dependency lockfiles and binary assets are excluded by default)."
        },
        "secretsEnvScanner.maxFileSizeKB": {
          "type": "number",
          "default": 1024,
          "description": "Maximum file size (in KB) to scan. Larger files are skipped."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
